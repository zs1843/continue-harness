{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/continue-harness/project.schema.json",
  "title": "continue-harness project configuration",
  "type": "object",
  "required": ["harness", "project"],
  "properties": {
    "harness": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "package": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "product_type": {
          "type": "string",
          "minLength": 1
        },
        "platforms": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "stack": {
      "type": "object",
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "package_manager": { "type": "string", "minLength": 1 }
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "system": {
          "oneOf": [
            {
              "type": "object",
              "required": ["status"],
              "properties": { "status": { "const": "not_configured" } }
            },
            {
              "type": "object",
              "required": ["adapter", "version", "policy"],
              "properties": {
                "adapter": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 },
                "policy": { "enum": ["required", "preferred", "none"] },
                "runtime": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": ["status"],
                      "properties": { "status": { "const": "not_installed" } }
                    },
                    {
                      "type": "object",
                      "required": ["status", "package", "version"],
                      "properties": {
                        "status": { "const": "installed" },
                        "package": { "type": "string", "minLength": 1 },
                        "version": { "type": "string", "minLength": 1 }
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "sources": {
      "type": "object",
      "properties": {
        "api": {
          "type": "object",
          "required": ["provider", "snapshot"],
          "properties": {
            "provider": { "const": "openapi" },
            "snapshot": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "verify": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          {
            "type": "object",
            "required": ["commands"],
            "properties": {
              "fail_fast": { "type": "boolean" },
                "commands": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
              }
            }
          },
          {
            "type": "object",
            "required": ["status", "commands"],
            "properties": {
              "status": { "const": "not_configured" },
              "commands": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        ]
      }
    }
  }
}
